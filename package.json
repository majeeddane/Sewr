{
  "name": "sewr-waie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate --schema prisma/schema.dev.prisma && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:generate:dev": "prisma generate --schema prisma/schema.dev.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --schema prisma/schema.prisma",
    "db:setup": "prisma db push --schema prisma/schema.dev.prisma --skip-generate --accept-data-loss && npm run db:generate:dev && npm run db:seed",
    "db:setup:pg": "prisma generate --schema prisma/schema.prisma && prisma migrate deploy --schema prisma/schema.prisma && npm run db:seed",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:studio:dev": "prisma studio --schema prisma/schema.dev.prisma",
    "setup": "npm run db:setup",
    "lint:content": "tsx scripts/lint-content.ts",
    "lint:jsx": "tsx scripts/lint-jsx.ts",
    "lint:docs": "tsx scripts/lint-docs.ts",
    "content:lint": "npm run lint:content && npm run lint:jsx && npm run lint:docs",
    "test:smoke": "tsx scripts/smoke-test.ts",
    "verify:schema": "tsx scripts/verify-schema.ts",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "verify:secrets": "tsx scripts/verify-secrets.ts",
    "db:inspect": "tsx scripts/inspect-db.ts",
    "db:apply": "tsx scripts/inspect-db.ts --apply-schema && tsx scripts/inspect-db.ts --apply-seed",
    "verify:production-db": "tsx scripts/verify-production-db.ts",
    "check:live": "tsx scripts/check-live.ts",
    "check:leading": "tsx scripts/check-arabic-leading.ts",
    "stress:live": "tsx scripts/stress-live.ts",
    "find:pooler": "tsx scripts/find-pooler.ts",
    "db:content": "tsx scripts/check-content.ts",
    "test:db-guard": "tsx scripts/test-db-guard.ts",
    "test:empty-db": "tsx scripts/test-empty-db.ts",
    "seed:sql": "tsx scripts/generate-seed-sql.ts",
    "db:migration:baseline": "tsx scripts/generate-baseline-migration.ts",
    "verify:encryption": "tsx scripts/verify-encryption.ts",
    "verify:booking": "tsx scripts/verify-booking.ts",
    "placeholders": "tsx scripts/generate-placeholders.ts",
    "fonts:og": "tsx scripts/fetch-og-font.ts",
    "verify": "npm run typecheck && npm run lint && npm run content:lint && npm run verify:secrets && npm run test:db-guard && npm run test:empty-db && npm run verify:schema && npm run verify:migration && npm run build"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
