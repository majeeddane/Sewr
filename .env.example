# ─────────────────────────────────────────────────────────────
#  سوار وعي — Sewr Waie  |  Environment Variables
#  Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Development (zero-config, file-based):
DATABASE_URL="file:./dev.db"
# Production / Supabase (PostgreSQL) — see docs/DEPLOYMENT.md
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?schema=public"

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Secrets (generate with: openssl rand -hex 32) ───────────
# Signs the session cookie. MUST be changed in production.
SESSION_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
# Derives the AES-256-GCM key used to encrypt client PII at rest.
DATA_ENCRYPTION_KEY="CHANGE_ME_generate_with_openssl_rand_hex_32"

# ── First admin account (created by `npm run db:seed`) ──────
ADMIN_NAME="مدير النظام"
ADMIN_EMAIL="admin@sewrwaie.sa"
ADMIN_PASSWORD="SewrWaie@2026"

# ── Email notifications (SMTP) ──────────────────────────────
# Leave empty in development: emails are printed to the console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="سوار وعي <no-reply@sewrwaie.sa>"
# Where lead / booking / message notifications are delivered.
NOTIFICATION_EMAIL="admin@sewrwaie.sa"

# ── Media storage ───────────────────────────────────────────
# "local"  → files written to ./public/uploads (dev & most VPS hosts)
# "supabase" → Supabase Storage bucket
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# ── Security tuning ─────────────────────────────────────────
# Failed logins before the account is temporarily locked.
MAX_LOGIN_ATTEMPTS="5"
LOCK_MINUTES="15"
# Automatic logout after this many minutes without activity.
SESSION_IDLE_MINUTES="120"
SESSION_MAX_AGE_HOURS="24"
# Simple IP rate limit for the public forms.
FORM_RATE_LIMIT_PER_HOUR="5"

# ── reCAPTCHA v3 (optional — honeypot is always active) ──────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
